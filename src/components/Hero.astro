---
import { Image, getImage } from 'astro:assets';
import heroDesktop from '../assets/images/hero.jpg';
import heroMobile from '../assets/images/hero-sp.png';

const mobileWidths = [480, 768, heroMobile.width];
const mobileImages = await Promise.all(
  mobileWidths.map((width) => getImage({ src: heroMobile, width, format: 'webp', quality: 88 })),
);
const mobileSrcset = mobileImages
  .map((image, index) => `${image.src} ${mobileWidths[index]}w`)
  .join(', ');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <h1 class="visually-hidden" id="hero-title">
    Healing｜湘南発 出張アロマ性感マッサージ
  </h1>
  <p class="visually-hidden">
    20代から30代の厳選された美女セラピストによる、アロマオイルマッサージで心身ともにリラックス。魅力あふれる美女エステティシャンが多数在籍しています。
  </p>

  <picture class="hero__picture" data-hero-media>
    <source
      media="(max-width: 767px), (orientation: portrait)"
      srcset={mobileSrcset}
      sizes="100vw"
      type="image/webp"
    />
    <Image
      class="hero__image"
      src={heroDesktop}
      alt=""
      width={heroDesktop.width}
      height={heroDesktop.height}
      widths={[heroDesktop.width]}
      sizes="100vw"
      format="webp"
      quality={90}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 251, 242, 0.98), rgba(208, 170, 125, 0.7) 72%),
      #d0aa7d;

    &__picture {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      transform-origin: center;
      will-change: transform;
    }

    &__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__picture {
      will-change: auto;
    }
  }
</style>
