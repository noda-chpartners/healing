---
import { siteContent } from '../data/siteContent';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <p class="hero__outline" aria-hidden="true">HEALING</p>

  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="hero__eyebrow reveal-hero">SHONAN / FUJISAWA / DELIVERY SERVICE</p>
      <h1 class="hero__title reveal-hero" id="hero-title">
        <span class="hero__title-brand">Healing</span>
        <span class="hero__title-ja">湘南発<br /><span class="no-break">出張アロマ性感マッサージ</span></span>
      </h1>
      <p class="hero__lead reveal-hero">
        藤沢駅から徒歩3分。<br />湘南エリアのホテル・ご自宅へ伺います。
      </p>

      <div class="hero__actions reveal-hero">
        <a class="hero__action hero__action--phone link-reset" href={`tel:${siteContent.telephone}`}>
          <span class="hero__action-label">PHONE</span>
          <span class="hero__action-value">{siteContent.telephoneDisplay}</span>
        </a>
        <a class="hero__action hero__action--line link-reset" href={siteContent.lineUrl} target="_blank" rel="noopener noreferrer">
          <span class="hero__action-label">OFFICIAL LINE</span>
          <span class="hero__action-value">LINEで予約する</span>
        </a>
      </div>
    </div>

    <div class="hero__side reveal-hero">
      <p class="hero__side-index">OPEN</p>
      <p class="hero__side-hours">{siteContent.hours}</p>
      <p class="hero__side-holiday">{siteContent.holiday}</p>
      <span class="hero__side-rule" aria-hidden="true"></span>
      <p class="hero__side-station">FUJISAWA<br />STATION 3 MIN.</p>
    </div>
  </div>

  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      <span class="hero__ticker-text">HEALING SHONAN — AROMA — PRIVATE TIME —</span>
      <span class="hero__ticker-text">HEALING SHONAN — AROMA — PRIVATE TIME —</span>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.18);

    &::before {
      position: absolute;
      inset: 1.5rem;
      border: 1px solid rgba(121, 92, 41, 0.36);
      content: '';
      pointer-events: none;
    }

    &__inner {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(2rem, 6vw, 7rem);
      align-items: center;
      padding-block: calc(var(--header-height) + 5rem) 8rem;
    }

    &__copy {
      min-width: 0;
    }

    &__eyebrow {
      margin: 0 0 1rem;
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.2em;
    }

    &__title {
      display: grid;
      gap: 0.5rem;
      margin: 0;
    }

    &__title-brand {
      width: max-content;
      max-width: 100%;
      color: var(--color-ink);
      font-family: var(--font-display);
      font-size: clamp(6rem, 16vw, 14rem);
      font-style: italic;
      font-weight: 600;
      letter-spacing: -0.075em;
      line-height: 0.68;
      white-space: nowrap;
    }

    &__title-ja {
      color: var(--color-ink);
      font-family: var(--font-sans);
      font-size: clamp(1.75rem, 4vw, 4.2rem);
      font-weight: 700;
      letter-spacing: -0.07em;
      line-height: 1.2;
    }

    &__lead {
      margin: clamp(1.4rem, 3vw, 2.5rem) 0 0;
      color: var(--color-ink-soft);
      font-size: clamp(0.82rem, 1.1vw, 1rem);
      letter-spacing: 0.08em;
      line-height: 2;
    }

    &__actions {
      display: flex;
      width: min(100%, 620px);
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
      border: 1px solid var(--color-ink);
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.58);
    }

    &__action {
      display: grid;
      flex: 1;
      gap: 0.15rem;
      align-content: center;
      min-width: 0;
      min-height: 78px;
      padding: 0.9rem 1.6rem;
      transition: color 0.3s ease, background-color 0.3s ease;

      &--phone {
        color: #fff;
        background: var(--color-ink);
      }

      &--line {
        border-left: 1px solid var(--color-ink);
      }

      &:hover,
      &:focus-visible {
        color: #fff;
        background: var(--color-gold-dark);
      }
    }

    &__action-label {
      font-family: var(--font-display);
      font-size: 0.55rem;
      font-weight: 600;
      letter-spacing: 0.18em;
    }

    &__action-value {
      font-size: clamp(0.88rem, 1.4vw, 1.12rem);
      font-weight: 700;
      white-space: nowrap;
    }

    &__side {
      display: grid;
      justify-items: center;
      align-content: center;
      width: clamp(150px, 16vw, 210px);
      min-height: 210px;
      padding: 1.5rem;
      border: 1px solid rgba(121, 92, 41, 0.46);
      text-align: center;
      background: rgba(255, 255, 255, 0.46);
      box-shadow: 14px 14px 0 rgba(185, 148, 79, 0.13);
      backdrop-filter: blur(4px);
    }

    &__side-index,
    &__side-hours,
    &__side-holiday,
    &__side-station {
      margin: 0;
    }

    &__side-index,
    &__side-station {
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.16em;
    }

    &__side-hours {
      margin-top: 0.2rem;
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 2.2vw, 2rem);
      font-weight: 600;
    }

    &__side-holiday {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }

    &__side-rule {
      width: 2.5rem;
      height: 1px;
      margin-block: 0.85rem;
      background: var(--color-gold);
    }

    &__outline {
      position: absolute;
      right: -0.05em;
      bottom: 3rem;
      margin: 0;
      color: transparent;
      font-family: var(--font-display);
      font-size: clamp(10rem, 26vw, 26rem);
      font-style: italic;
      font-weight: 600;
      letter-spacing: -0.08em;
      line-height: 0.7;
      white-space: nowrap;
      -webkit-text-stroke: 1px rgba(121, 92, 41, 0.16);
      pointer-events: none;
    }

    &__ticker {
      position: absolute;
      z-index: 3;
      right: 0;
      bottom: 0;
      left: 0;
      overflow: hidden;
      color: #fff;
      border-block: 1px solid var(--color-gold);
      background: var(--color-ink);
      transform: rotate(-1.2deg) scale(1.02);
    }

    &__ticker-track {
      display: flex;
      width: max-content;
      animation: hero-ticker 22s linear infinite;
    }

    &__ticker-text {
      padding: 0.8rem 1.4rem;
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      white-space: nowrap;
    }
  }

  @keyframes hero-ticker {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 767px) {
    .hero {
      &::before {
        inset: 0.75rem;
      }

      &__inner {
        grid-template-columns: 1fr;
        gap: 1.25rem;
        align-content: center;
        padding-block: calc(var(--header-height) + 3.5rem) 6rem;
      }

      &__title-brand {
        font-size: clamp(5rem, 27vw, 7.5rem);
      }

      &__title-ja {
        font-size: clamp(1.55rem, 8vw, 2.4rem);
      }

      &__lead {
        line-height: 1.8;
      }

      &__actions {
        border-radius: 1.25rem;
      }

      &__action {
        min-height: 68px;
        padding-inline: 0.9rem;
      }

      &__action-value {
        font-size: 0.82rem;
      }

      &__side {
        position: absolute;
        top: 0.5rem;
        right: 0;
        width: 126px;
        min-height: 108px;
        padding: 0.8rem;
        box-shadow: 8px 8px 0 rgba(185, 148, 79, 0.12);
      }

      &__side-hours {
        font-size: 1rem;
      }

      &__side-rule,
      &__side-station {
        display: none;
      }
    }
  }

  @media (max-width: 370px), (max-height: 700px) {
    .hero {
      &__inner {
        padding-block: calc(var(--header-height) + 2rem) 5rem;
      }

      &__eyebrow {
        margin-bottom: 0.6rem;
      }

      &__title-brand {
        font-size: clamp(4rem, 23vw, 5.5rem);
      }

      &__title-ja {
        font-size: 1.35rem;
      }

      &__lead {
        margin-top: 0.8rem;
        font-size: 0.72rem;
      }

      &__actions {
        margin-top: 0.9rem;
      }

      &__action {
        min-height: 56px;
      }

      &__side {
        display: none;
      }
    }
  }

  @media (min-width: 768px) and (max-height: 700px) {
    .hero {
      &__inner {
        padding-block: calc(var(--header-height) + 0.75rem) 3.25rem;
      }

      &__title-brand {
        font-size: 5.2rem;
      }

      &__title-ja {
        font-size: 1.55rem;
      }

      &__lead {
        display: none;
      }

      &__actions {
        width: 520px;
        margin-top: 0.85rem;
      }

      &__action {
        min-height: 52px;
        padding-block: 0.5rem;
      }

      &__side {
        width: 112px;
        min-height: 104px;
        padding: 0.8rem;
      }

      &__side-hours {
        font-size: 1rem;
      }

      &__side-rule,
      &__side-station {
        display: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ticker-track {
      animation: none;
    }
  }
</style>
