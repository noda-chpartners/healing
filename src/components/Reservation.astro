---
import { siteContent } from '../data/siteContent';
---

<section class="reservation" id="reservation" aria-labelledby="reservation-title">
  <div class="reservation__inner container">
    <p class="reservation__eyebrow reveal-item">RESERVATION</p>
    <h2 class="reservation__title reveal-item" id="reservation-title">
      <span class="reservation__title-line">ご予約は、</span>
      <span class="reservation__title-line reservation__title-line--accent">お電話かLINEから。</span>
    </h2>

    <div class="reservation__links reveal-item">
      <a class="reservation__link link-reset" href={`tel:${siteContent.telephone}`}>
        <span class="reservation__link-label">PHONE</span>
        <span class="reservation__link-value">{siteContent.telephoneDisplay}</span>
        <span class="reservation__link-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="reservation__link link-reset" href={siteContent.lineUrl} target="_blank" rel="noopener noreferrer">
        <span class="reservation__link-label">OFFICIAL LINE</span>
        <span class="reservation__link-value">LINEで予約する</span>
        <span class="reservation__link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="reservation__hours reveal-item">OPEN {siteContent.hours} / {siteContent.holiday}</p>
  </div>
</section>

<style lang="scss">
  .reservation {
    padding-block: clamp(7rem, 13vw, 13rem);
    color: var(--color-ink);
    background:
      radial-gradient(circle at 82% 20%, rgba(185, 148, 79, 0.16), transparent 36%),
      linear-gradient(135deg, rgba(240, 234, 220, 0.82), rgba(255, 255, 255, 0.74));

    &__inner {
      text-align: center;
    }

    &__eyebrow {
      margin: 0 0 1.5rem;
      color: var(--color-gold-dark);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.3em;
    }

    &__title {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2.8rem, 7.2vw, 8rem);
      font-weight: 400;
      letter-spacing: -0.06em;
      line-height: 1.05;
    }

    &__title-line {
      display: block;
      white-space: nowrap;

      &--accent {
        color: var(--color-gold-dark);
        font-style: italic;
      }
    }

    &__links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: min(100%, 900px);
      margin: clamp(3.5rem, 7vw, 6rem) auto 0;
      border: 1px solid rgba(29, 27, 23, 0.42);
    }

    &__link {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.7rem 1rem;
      align-items: center;
      min-width: 0;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      text-align: left;
      transition: color 0.3s ease, background-color 0.3s ease;

      & + & {
        border-left: 1px solid rgba(29, 27, 23, 0.42);
      }

      &:hover,
      &:focus-visible {
        color: #fff;
        background: var(--color-gold-dark);
      }
    }

    &__link-label {
      grid-column: 1;
      color: var(--color-gold-dark);
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.2em;
    }

    &__link-value {
      grid-column: 1;
      min-width: 0;
      font-family: var(--font-serif);
      font-size: clamp(1rem, 2vw, 1.55rem);
      white-space: nowrap;
    }

    &__link-arrow {
      grid-row: 1 / 3;
      grid-column: 2;
      font-size: 1.4rem;
    }

    &__hours {
      margin: 2rem 0 0;
      color: var(--color-ink-soft);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.17em;
    }
  }

  @media (max-width: 767px) {
    .reservation {
      padding-block: 7rem;

      &__title {
        font-size: clamp(2rem, 9.7vw, 3.3rem);
      }

      &__links {
        grid-template-columns: 1fr;
        margin-top: 3rem;
      }

      &__link {
        padding: 1.4rem;

        & + & {
          border-top: 1px solid rgba(29, 27, 23, 0.42);
          border-left: 0;
        }
      }
    }
  }

  @media (max-width: 370px) {
    .reservation__title {
      font-size: 2rem;
    }
  }
</style>
