---
import { Image } from 'astro:assets';
import cast01 from '../assets/images/cast01.png';
import cast03 from '../assets/images/cast03.png';
import SectionHeading from './SectionHeading.astro';
---

<section class="about" id="concept" aria-labelledby="concept-title">
  <div class="about__inner container">
    <div class="about__heading">
      <SectionHeading en="ABOUT HEALING" ja="湘南へ伺う、出張型サービス。" id="concept-title" />
    </div>

    <div class="about__layout">
      <div class="about__copy reveal-item">
        <p class="about__lead">
          <span class="no-break">ラブホテル・ビジネスホテル・</span><br />
          <span class="no-break">シティホテル・ご自宅へ。</span>
        </p>
        <p class="about__text">
          Healingは、湘南エリアへ伺う出張アロマ性感マッサージ・ヘルスサービスです。藤沢駅徒歩3分、12時から翌3時まで年中無休でご予約を承っています。
        </p>
        <div class="about__facts">
          <p class="about__fact"><span class="about__fact-en">AREA</span><span class="about__fact-ja">湘南エリア</span></p>
          <p class="about__fact"><span class="about__fact-en">OPEN</span><span class="about__fact-ja">12:00〜翌3:00</span></p>
          <p class="about__fact"><span class="about__fact-en">CLOSE</span><span class="about__fact-ja">年中無休</span></p>
        </div>
      </div>

      <div class="about__visual reveal-item">
        <figure class="about__photo about__photo--main">
          <Image class="about__image" src={cast03} alt="Healingの女性イメージ" widths={[420, 640, 820]} sizes="(max-width: 767px) 66vw, 31vw" format="webp" quality={84} loading="lazy" />
        </figure>
        <figure class="about__photo about__photo--sub">
          <Image class="about__image" src={cast01} alt="Healingの女性イメージ" widths={[260, 420, 560]} sizes="(max-width: 767px) 42vw, 18vw" format="webp" quality={84} loading="lazy" />
        </figure>
        <p class="about__visual-label">PRIVATE / SHONAN / HEALING</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .about {
    position: relative;
    padding-block: clamp(7rem, 12vw, 12rem);
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(1px);

    &__heading {
      width: min(100%, 1040px);
    }

    &__layout {
      display: grid;
      grid-template-columns: minmax(300px, 0.88fr) minmax(420px, 1.12fr);
      gap: clamp(4rem, 9vw, 10rem);
      align-items: center;
      margin-top: clamp(4rem, 8vw, 8rem);
    }

    &__lead {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(1.65rem, 3.2vw, 3.2rem);
      font-weight: 500;
      letter-spacing: -0.06em;
      line-height: 1.55;
    }

    &__text {
      max-width: 36rem;
      margin: 2.5rem 0 0;
      color: var(--color-ink-soft);
      font-size: clamp(0.82rem, 1.05vw, 0.98rem);
      letter-spacing: 0.06em;
      line-height: 2.2;
    }

    &__facts {
      display: grid;
      margin-top: 3rem;
      border-top: 1px solid var(--color-line);
    }

    &__fact {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      gap: 1rem;
      margin: 0;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--color-line);
    }

    &__fact-en {
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.15em;
    }

    &__fact-ja {
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.05em;
    }

    &__visual {
      position: relative;
      min-height: clamp(560px, 50vw, 740px);
    }

    &__photo {
      position: absolute;
      margin: 0;
      overflow: hidden;
      background: var(--color-gold-soft);
      box-shadow: 0 28px 70px rgba(80, 66, 42, 0.15);

      &--main {
        top: 0;
        right: 0;
        width: min(72%, 480px);
        aspect-ratio: 3 / 4;
        border-radius: 12rem 12rem 2rem 2rem;
      }

      &--sub {
        bottom: 0;
        left: 0;
        width: min(44%, 290px);
        aspect-ratio: 3 / 4;
        border: 8px solid #fff;
        border-radius: 2rem;
        transform: rotate(-4deg);
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.16) sepia(0.12) saturate(0.74) contrast(1.02);
    }

    &__visual-label {
      position: absolute;
      right: -1.25rem;
      bottom: 1rem;
      margin: 0;
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      writing-mode: vertical-rl;
    }
  }

  @media (max-width: 900px) {
    .about {
      &__layout {
        grid-template-columns: 1fr;
      }

      &__visual {
        width: min(100%, 620px);
        margin-inline: auto;
      }
    }
  }

  @media (max-width: 767px) {
    .about {
      padding-block: 7rem;

      &__layout {
        gap: 3.5rem;
        margin-top: 3.5rem;
      }

      &__lead {
        font-size: clamp(1.45rem, 7vw, 2.1rem);
      }

      &__text {
        margin-top: 1.75rem;
        font-size: 0.82rem;
        line-height: 2;
      }

      &__visual {
        min-height: 540px;
      }

      &__photo--main {
        width: 75%;
      }

      &__photo--sub {
        width: 46%;
      }
    }
  }
</style>
