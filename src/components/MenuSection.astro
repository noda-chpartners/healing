---
import { siteContent } from '../data/siteContent';
import SectionHeading from './SectionHeading.astro';
---

<section class="menu-section" id="menu" aria-labelledby="menu-title">
  <div class="menu-section__inner container">
    <div class="menu-section__top">
      <SectionHeading en="COURSE & PRICE" ja="メニュー" id="menu-title" />
      <p class="menu-section__count reveal-item">4 COURSES</p>
    </div>

    <div class="menu-section__list">
      {siteContent.courses.map((course) => (
        <article class="course-row reveal-item">
          <p class="course-row__number">{course.number}</p>
          <h3 class="course-row__name">{course.name}</h3>
          <p class="course-row__duration">{course.duration}</p>
          <p class="course-row__price">{course.price}</p>
        </article>
      ))}
    </div>

    <div class="menu-section__bottom reveal-item">
      <p class="menu-section__note">コース内容・その他の料金については既存HPの料金システムをご確認ください。</p>
      <a class="menu-section__more link-reset" href={siteContent.rateUrl} target="_blank" rel="noopener noreferrer">
        <span class="menu-section__more-en">VIEW FULL RATE SYSTEM</span>
        <span class="menu-section__more-ja">料金システムを詳しく見る</span>
        <span class="menu-section__more-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .menu-section {
    position: relative;
    padding-block: clamp(7rem, 12vw, 12rem);
    background: rgba(255, 255, 255, 0.74);

    &::before {
      position: absolute;
      top: 0;
      right: 0;
      width: min(42vw, 620px);
      height: 9px;
      border-radius: 0 0 0 99px;
      background: linear-gradient(90deg, var(--color-ink), var(--color-gold));
      content: '';
    }

    &__top {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 2rem;
      margin-bottom: clamp(4rem, 7vw, 6.5rem);
    }

    &__count {
      margin: 0 0 0.6rem;
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.17em;
      white-space: nowrap;
    }

    &__list {
      border-top: 2px solid var(--color-ink);
    }

    &__bottom {
      display: grid;
      grid-template-columns: 1fr minmax(300px, 420px);
      gap: 3rem;
      align-items: center;
      margin-top: 2.5rem;
    }

    &__note {
      margin: 0;
      color: var(--color-ink-soft);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      line-height: 1.9;
    }

    &__more {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.15rem 1rem;
      align-items: center;
      padding: 1.25rem 1.55rem;
      border: 1px solid var(--color-gold-dark);
      border-radius: 999px;
      color: var(--color-gold-dark);
      background: #fff;
      transition: color 0.25s ease, background-color 0.25s ease;

      &:hover,
      &:focus-visible {
        color: #fff;
        background: var(--color-gold-dark);
      }
    }

    &__more-en {
      font-family: var(--font-display);
      font-size: 0.55rem;
      font-weight: 600;
      letter-spacing: 0.14em;
    }

    &__more-ja {
      font-size: 0.9rem;
      font-weight: 700;
    }

    &__more-arrow {
      grid-row: 1 / 3;
      grid-column: 2;
      font-size: 1.3rem;
    }
  }

  .course-row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 7rem 10rem;
    gap: clamp(0.75rem, 2vw, 2rem);
    align-items: center;
    min-height: clamp(108px, 10vw, 148px);
    border-bottom: 1px solid rgba(29, 27, 23, 0.28);
    transition: padding-inline 0.3s ease;

    &::before {
      position: absolute;
      z-index: 0;
      inset: 0;
      background: linear-gradient(90deg, rgba(234, 223, 200, 0.78), rgba(255, 255, 255, 0.48));
      content: '';
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.35s ease;
    }

    &:hover {
      padding-inline: 1.25rem;

      &::before {
        transform: scaleX(1);
        transform-origin: left;
      }
    }

    &__number,
    &__name,
    &__duration,
    &__price {
      position: relative;
      z-index: 1;
      margin: 0;
    }

    &__number {
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.4vw, 2.4rem);
      font-style: italic;
      font-weight: 600;
    }

    &__name {
      min-width: 0;
      font-size: clamp(1.15rem, 2.3vw, 2.15rem);
      font-weight: 700;
      letter-spacing: -0.055em;
      line-height: 1.35;
      word-break: keep-all;
    }

    &__duration,
    &__price {
      font-family: var(--font-serif);
      font-size: clamp(0.98rem, 1.5vw, 1.3rem);
      font-weight: 500;
      white-space: nowrap;
    }

    &__price {
      color: var(--color-gold-dark);
      text-align: right;
    }
  }

  @media (max-width: 767px) {
    .menu-section {
      padding-block: 7rem;

      &__top {
        align-items: start;
        margin-bottom: 3.5rem;
      }

      &__count {
        margin-top: 0.4rem;
        font-size: 0.55rem;
      }

      &__bottom {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }

    .course-row {
      grid-template-columns: 2.2rem minmax(0, 1fr) auto;
      grid-template-areas:
        "num name name"
        "num duration price";
      gap: 0.5rem 0.75rem;
      min-height: 126px;
      padding-block: 1.35rem;

      &:hover {
        padding-inline: 0.5rem;
      }

      &__number { grid-area: num; align-self: start; }
      &__name { grid-area: name; font-size: clamp(1.05rem, 5.2vw, 1.45rem); }
      &__duration { grid-area: duration; font-size: 0.88rem; }
      &__price { grid-area: price; font-size: 1rem; }
    }
  }
</style>
