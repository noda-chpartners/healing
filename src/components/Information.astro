---
import { siteContent } from '../data/siteContent';
import SectionHeading from './SectionHeading.astro';
---

<section class="information" id="information" aria-labelledby="information-title">
  <div class="information__inner container">
    <SectionHeading en="SHOP INFORMATION" ja="店舗情報" id="information-title" />

    <div class="information__layout">
      <p class="information__statement reveal-item">
        <span class="information__statement-line">藤沢から、</span>
        <span class="information__statement-line information__statement-line--accent">湘南の夜へ。</span>
      </p>

      <dl class="information__details reveal-item">
        <div class="information__row">
          <dt class="information__label">店舗名</dt>
          <dd class="information__value">{siteContent.name}</dd>
        </div>
        <div class="information__row">
          <dt class="information__label">電話番号</dt>
          <dd class="information__value">
            <a class="information__link link-reset" href={`tel:${siteContent.telephone}`}>{siteContent.telephoneDisplay}</a>
          </dd>
        </div>
        <div class="information__row">
          <dt class="information__label">所在地</dt>
          <dd class="information__value">
            <span class="information__postal">〒{siteContent.postalCode}</span>
            {siteContent.address}
          </dd>
        </div>
        <div class="information__row">
          <dt class="information__label">最寄駅</dt>
          <dd class="information__value">{siteContent.station}</dd>
        </div>
        <div class="information__row">
          <dt class="information__label">営業時間</dt>
          <dd class="information__value">{siteContent.hours}</dd>
        </div>
        <div class="information__row">
          <dt class="information__label">定休日</dt>
          <dd class="information__value">{siteContent.holiday}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style lang="scss">
  .information {
    position: relative;
    padding-block: clamp(7rem, 13vw, 13rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 90% 10%, rgba(185, 148, 79, 0.14), transparent 35%),
      rgba(255, 255, 255, 0.7);

    &__layout {
      display: grid;
      grid-template-columns: minmax(280px, 0.85fr) minmax(420px, 1.15fr);
      gap: clamp(3rem, 8vw, 10rem);
      align-items: start;
      margin-top: clamp(4rem, 8vw, 8rem);
    }

    &__statement {
      position: sticky;
      top: calc(var(--header-height) + 4rem);
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4.2vw, 4.8rem);
      letter-spacing: -0.04em;
      line-height: 1.35;
    }

    &__statement-line {
      display: block;
      white-space: nowrap;

      &--accent {
        color: var(--color-gold-dark);
        font-style: italic;
      }
    }

    &__details {
      margin: 0;
      border-top: 1px solid var(--color-line);
    }

    &__row {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 2rem;
      padding-block: clamp(1.35rem, 2.5vw, 2rem);
      border-bottom: 1px solid var(--color-line);
    }

    &__label,
    &__value {
      margin: 0;
    }

    &__label {
      padding-top: 0.25rem;
      color: var(--color-gold-dark);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.16em;
    }

    &__value {
      font-family: var(--font-serif);
      font-size: clamp(1rem, 1.7vw, 1.35rem);
      letter-spacing: 0.04em;
      line-height: 1.65;
    }

    &__postal {
      display: block;
      color: var(--color-ink-soft);
      font-family: var(--font-sans);
      font-size: 0.72em;
    }

    &__link {
      position: relative;

      &::after {
        position: absolute;
        right: 0;
        bottom: -0.25rem;
        left: 0;
        height: 1px;
        background: currentColor;
        content: '';
        transform-origin: left;
        transition: transform 0.3s ease;
      }

      &:hover::after,
      &:focus-visible::after {
        transform: scaleX(0.45);
      }
    }
  }

  @media (max-width: 767px) {
    .information {
      padding-block: 7rem;

      &__layout {
        grid-template-columns: 1fr;
        gap: 3rem;
        margin-top: 3.5rem;
      }

      &__statement {
        position: static;
        font-size: clamp(2rem, 10vw, 3.3rem);
      }

      &__row {
        grid-template-columns: 5.5rem minmax(0, 1fr);
        gap: 1rem;
      }

      &__value {
        font-size: 0.98rem;
      }
    }
  }
</style>
