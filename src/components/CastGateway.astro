---
import { Image } from 'astro:assets';
import cast02 from '../assets/images/cast02.png';
import cast04 from '../assets/images/cast04.png';
import cast05 from '../assets/images/cast05.png';
import cast06 from '../assets/images/cast06.png';
import cast07 from '../assets/images/cast07.png';
import cast08 from '../assets/images/cast08.png';
import { siteContent } from '../data/siteContent';

const photos = [cast02, cast04, cast05, cast06, cast07, cast08];
---

<section class="cast-gateway" aria-labelledby="cast-gateway-title">
  <div class="cast-gateway__intro container reveal-item">
    <p class="cast-gateway__eyebrow">OFFICIAL CAST LIST</p>
    <h2 class="cast-gateway__title" id="cast-gateway-title">
      <span class="cast-gateway__title-en">Cast List.</span>
      <span class="cast-gateway__title-ja">最新の在籍情報は、既存HPでご覧いただけます。</span>
    </h2>
  </div>

  <a class="cast-gateway__link link-reset" href={siteContent.castUrl} target="_blank" rel="noopener noreferrer">
    <span class="visually-hidden">Healingの在籍一覧を見る</span>
    <span class="cast-gateway__photos" aria-hidden="true">
      {photos.map((photo, index) => (
        <span class={`cast-gateway__photo cast-gateway__photo--${index + 1}`}>
          <Image class="cast-gateway__image" src={photo} alt="" widths={[280, 420, 560]} sizes="(max-width: 767px) 42vw, 18vw" format="webp" quality={82} loading="lazy" />
        </span>
      ))}
    </span>
    <span class="cast-gateway__button">
      <span class="cast-gateway__button-en">VIEW CAST LIST</span>
      <span class="cast-gateway__button-ja">在籍一覧を見る</span>
      <span class="cast-gateway__button-arrow" aria-hidden="true">↗</span>
    </span>
  </a>
</section>

<style lang="scss">
  .cast-gateway {
    position: relative;
    padding-block: clamp(6rem, 10vw, 10rem);
    overflow: hidden;
    background: rgba(240, 234, 220, 0.76);

    &__intro {
      position: relative;
      z-index: 2;
    }

    &__eyebrow {
      margin: 0 0 0.7rem;
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.18em;
    }

    &__title {
      display: grid;
      gap: 0.4rem;
      margin: 0;
    }

    &__title-en {
      font-family: var(--font-display);
      font-size: clamp(4.5rem, 11vw, 11rem);
      font-style: italic;
      font-weight: 600;
      letter-spacing: -0.07em;
      line-height: 0.72;
    }

    &__title-ja {
      font-size: clamp(1rem, 2vw, 1.5rem);
      font-weight: 700;
      letter-spacing: -0.04em;
    }

    &__link {
      display: block;
      width: 100%;
      min-width: 0;
      margin-top: clamp(3rem, 6vw, 5.5rem);
      overflow: hidden;
    }

    &__photos {
      display: grid;
      grid-template-columns: repeat(6, minmax(190px, 1fr));
      gap: clamp(0.6rem, 1.2vw, 1.2rem);
      width: max(1180px, 112vw);
      margin-left: -6vw;
      transform: rotate(-1.4deg);
    }

    &__photo {
      display: block;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border: 6px solid #fff;
      border-radius: 1.3rem;
      background: #fff;
      box-shadow: 0 18px 40px rgba(74, 62, 42, 0.14);
      transition: transform 0.35s ease;

      &--2,
      &--5 {
        transform: translateY(2.5rem);
      }

      &--3 {
        transform: translateY(-1.4rem);
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.16) sepia(0.12) saturate(0.74) contrast(1.02);
    }

    &__link:hover &__photo,
    &__link:focus-visible &__photo {
      transform: translateY(-0.8rem) rotate(1deg);
    }

    &__button {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.2rem 1.2rem;
      align-items: center;
      width: min(calc(100% - 40px), 430px);
      margin: -2rem auto 0;
      padding: 1.35rem 1.7rem;
      border-radius: 999px;
      color: #fff;
      background: var(--color-ink);
      box-shadow: 0 18px 40px rgba(46, 39, 27, 0.22);
    }

    &__button-en {
      color: var(--color-gold-light);
      font-family: var(--font-display);
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.17em;
    }

    &__button-ja {
      font-size: 1rem;
      font-weight: 700;
    }

    &__button-arrow {
      grid-row: 1 / 3;
      grid-column: 2;
      font-size: 1.4rem;
    }
  }

  @media (max-width: 767px) {
    .cast-gateway {
      padding-block: 6.5rem;

      &__title-en {
        font-size: clamp(4.2rem, 24vw, 6.5rem);
      }

      &__title-ja {
        font-size: 0.92rem;
      }

      &__photos {
        grid-template-columns: repeat(6, minmax(150px, 1fr));
        width: 1040px;
        margin-left: -240px;
      }

      &__photo {
        border-width: 4px;
      }

      &__button {
        margin-top: -1rem;
      }
    }
  }
</style>
