---
import { siteContent } from '../data/siteContent';
---

<section class="background-interlude" aria-label="営業時間と所在地">
  <div class="background-interlude__frame container reveal-item" data-depth-panel>
    <p class="background-interlude__eyebrow">HEALING / SHONAN / FUJISAWA</p>
    <p class="background-interlude__word" aria-hidden="true">Healing</p>
    <div class="background-interlude__meta">
      <p class="background-interlude__item">
        <span class="background-interlude__label">OPEN</span>
        <span class="background-interlude__value">{siteContent.hours}</span>
      </p>
      <span class="background-interlude__rule" aria-hidden="true"></span>
      <p class="background-interlude__item">
        <span class="background-interlude__label">ACCESS</span>
        <span class="background-interlude__value">{siteContent.station}</span>
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  .background-interlude {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 68svh;
    padding-block: 6rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);

    &::before,
    &::after {
      position: absolute;
      width: 1px;
      height: 18%;
      background: var(--color-gold);
      content: '';
    }

    &::before {
      top: 0;
      left: 12%;
    }

    &::after {
      right: 12%;
      bottom: 0;
    }

    &__frame {
      position: relative;
      display: grid;
      min-height: clamp(300px, 38vw, 470px);
      padding: clamp(2rem, 5vw, 5rem);
      border: 1px solid rgba(121, 92, 41, 0.58);
      background: rgba(255, 255, 255, 0.2);
      box-shadow: 24px 24px 0 rgba(121, 92, 41, 0.09);
      backdrop-filter: blur(2px);
    }

    &__eyebrow {
      position: relative;
      z-index: 2;
      margin: 0;
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.24em;
    }

    &__word {
      align-self: center;
      margin: 0;
      color: rgba(29, 27, 23, 0.76);
      font-family: var(--font-display);
      font-size: clamp(6rem, 18vw, 17rem);
      font-style: italic;
      font-weight: 600;
      letter-spacing: -0.075em;
      line-height: 0.7;
      white-space: nowrap;
    }

    &__meta {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: clamp(1rem, 3vw, 2.5rem);
      justify-self: end;
    }

    &__item {
      display: grid;
      gap: 0.2rem;
      margin: 0;
    }

    &__label {
      color: var(--color-gold-dark);
      font-family: var(--font-display);
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.18em;
    }

    &__value {
      font-family: var(--font-serif);
      font-size: clamp(0.85rem, 1.3vw, 1.05rem);
      font-weight: 500;
      white-space: nowrap;
    }

    &__rule {
      width: clamp(2rem, 5vw, 5rem);
      height: 1px;
      background: var(--color-gold);
    }
  }

  @media (max-width: 767px) {
    .background-interlude {
      min-height: 62svh;
      padding-block: 4rem;

      &__frame {
        min-height: 360px;
        padding: 2rem 1.25rem;
        box-shadow: 12px 12px 0 rgba(121, 92, 41, 0.09);
      }

      &__word {
        font-size: clamp(5.2rem, 27vw, 7rem);
      }

      &__meta {
        display: grid;
        justify-self: start;
        gap: 0.75rem;
      }

      &__rule {
        width: 3rem;
      }
    }
  }
</style>
