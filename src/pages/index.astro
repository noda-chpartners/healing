---
import BaseLayout from '../layouts/BaseLayout.astro';
import FixedBackground from '../components/FixedBackground.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import BackgroundInterlude from '../components/BackgroundInterlude.astro';
import CastGateway from '../components/CastGateway.astro';
import MenuSection from '../components/MenuSection.astro';
import Information from '../components/Information.astro';
import Reservation from '../components/Reservation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteContent } from '../data/siteContent';

const title = 'Healing｜湘南・藤沢の出張アロマ性感マッサージ';
---

<BaseLayout title={title} description={siteContent.description}>
  <FixedBackground />
  <SiteHeader />
  <main class="page__main">
    <Hero />
    <About />
    <BackgroundInterlude />
    <CastGateway />
    <MenuSection />
    <Information />
    <Reservation />
  </main>
  <SiteFooter />
  <script>
    import '../scripts/motion';
  </script>
</BaseLayout>
